ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# JUDGE_MODEL: Layer A 검증 심판. 코치(Claude)와 다른 계열일수록 자기선호 편향이 적음.
#   - gpt-4o            : 권장 (코치와 교차 계열, OPENAI_API_KEY 재사용, sonnet보다 저렴)
#   - gemini-1.5-pro    : 코치·페르소나 둘 다와 독립(최대 엄밀) — GEMINI_API_KEY 필요(유료)
#   - claude-sonnet-4-5 : 코치와 동일 계열(편향 위험) — 추가 키 불필요
#   - claude-haiku-4-5  : 배관 검증용(저렴, 분별력 낮음)
COACH_MODEL=claude-sonnet-4-5
PERSONA_MODEL=gpt-4o
JUDGE_MODEL=gpt-4o

CAREERPT_SIM_HOME=

# CACHE_TTL: 코치 system 캐시 수명. 단건 실행은 5m, 라운드(여러 명) 배치는 1h 권장.
#   5m (기본): 쓰기 1.25x. 1명 안에서 캐시 1회 생성·수십 회 읽기 → 단건에 최적.
#   1h       : 쓰기 2x 이지만 페르소나 간 캐시 재사용 → 배치(라운드)에서 cache_create 대폭 절감.
CACHE_TTL=5m
