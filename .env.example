# =====================================================
# CareerPT 환경 변수 템플릿
# =====================================================
# 이 파일을 복사해서 .env.local 로 이름 바꾸고
# 실제 값을 채워주세요.
#
# 복사 명령어:
#   cp .env.example .env.local
#
# Supabase 대시보드에서 값 확인:
#   https://supabase.com/dashboard → 프로젝트 선택 → Settings → API
# =====================================================

# Supabase 프로젝트 URL (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon key — 프론트엔드용, 공개 가능 (Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
